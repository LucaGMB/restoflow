{
  "name": "restoflow-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DATABASE_URL=\"file:./dev.db\" tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "DATABASE_URL=\"file:./test.db\" prisma db push --skip-generate && vitest run",
    "db:generate": "DATABASE_URL=\"file:./dev.db\" prisma generate",
    "db:push": "DATABASE_URL=\"file:./dev.db\" prisma db push",
    "db:migrate": "DATABASE_URL=\"file:./dev.db\" prisma migrate dev",
    "db:seed": "DATABASE_URL=\"file:./dev.db\" tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.5.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prisma": "6.5.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
